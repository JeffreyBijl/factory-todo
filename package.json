{
	"name": "factory-todo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"ng": "ng",
		"start": "node server/main.ts",
		"dev": "ng serve --proxy-config proxy.conf.json",
		"dev:api": "node --watch server/main.ts",
		"build": "ng build",
		"test": "ng test && vitest run --config vitest.server.config.ts",
		"test:app": "ng test",
		"test:server": "vitest run --config vitest.server.config.ts",
		"e2e": "playwright test --pass-with-no-tests",
		"lint": "ng lint",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@angular/common": "^22.2.0",
		"@angular/compiler": "^22.2.0",
		"@angular/core": "^22.2.0",
		"@angular/forms": "^22.2.0",
		"@angular/platform-browser": "^22.2.0",
		"@angular/router": "^22.2.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^22.2.2",
		"@angular/cli": "^22.2.2",
		"@angular/compiler-cli": "^22.2.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@types/node": "^24.0.0",
		"angular-eslint": "22.6.0",
		"eslint": "^10.12.0",
		"jsdom": "^30.0.0",
		"prettier": "^3.9.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "8.71.0",
		"vitest": "^5.0.0"
	}
}
